# Copy this file to .env and fill in the values. Never commit a real .env.

# --- Database (Postgres + pgvector) ---
# Local (docker-compose): postgresql://clauselens:clauselens@localhost:5432/clauselens
# Neon (production): use the "pooled" connection string from the Neon dashboard.
DATABASE_URL=postgresql://clauselens:clauselens@localhost:5432/clauselens

# --- LLM provider (swappable layer) ---
# "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default models (can be overridden without touching code)
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5

# --- Embeddings ---
# The `chunks.embedding` schema is fixed to 3072 dimensions
# (text-embedding-3-large). Changing models requires migrating the column.
EMBEDDING_MODEL=text-embedding-3-large

# --- Ingest worker (apps/ingest-worker) ---
PORT=8787
NODE_ENV=development
