# Copia este archivo a .env y rellena los valores. Nunca commitees .env real.

# --- Base de datos (Postgres + pgvector) ---
# Local (docker-compose): postgresql://clauselens:clauselens@localhost:5432/clauselens
# Neon (producción): usa la connection string "pooled" del dashboard de Neon.
DATABASE_URL=postgresql://clauselens:clauselens@localhost:5432/clauselens

# --- Proveedor de LLM (capa intercambiable) ---
# "anthropic" o "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos por defecto (se pueden sobreescribir sin tocar código)
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5

# --- Embeddings ---
# El esquema de `chunks.embedding` está fijado a 3072 dimensiones
# (text-embedding-3-large). Si cambias de modelo, hay que migrar la columna.
EMBEDDING_MODEL=text-embedding-3-large

# --- Worker de ingesta (apps/ingest-worker) ---
PORT=8787
NODE_ENV=development
